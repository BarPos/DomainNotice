<Project Sdk="Microsoft.NET.Sdk.Razor">
    <!-- The web management panel (Blazor interactive server + MudBlazor). Hosted inside DomainNotice.Server (D1). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>DomainNotice.Console</RootNamespace>
        <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="Markdig" />
        <!--
            The Blazor framework script (_framework/blazor.web.js) is a static web asset in .NET 10. The SDK adds this
            package only to Web projects that contain .razor files, which the host (DomainNotice.Server) does not, so the
            script would 404 and no page would become interactive. Referencing it here flows it to the host, where its
            buildTransitive targets add the script. The version always follows the SDK's runtime (no central pin).
            Alternative for the integrator: <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets> in the Server csproj.
        -->
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" VersionOverride="$(BundledNETCoreAppPackageVersion)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DomainNotice.Server.Core\DomainNotice.Server.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="DomainNotice.Server.Tests" />
    </ItemGroup>
</Project>
