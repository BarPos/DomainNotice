<!DOCTYPE html>
<html lang="@T.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>DomainNotice</title>
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/DomainNotice.Console/console.css"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    @* Shown by console.js while the connection to the server is down (for example while the server updates). *@
    <div id="dn-reconnect" class="dn-reconnect" hidden role="alert" aria-live="assertive"
         data-down="@T["The connection to the server was lost. Reconnecting…"]"
         data-restarting="@T["The server is not reachable, for example because it is restarting after an update. This page continues as soon as it is back."]"
         data-back="@T["The server is back. Opening the sign-in page…"]">
        <div class="dn-reconnect-box">
            <div class="dn-reconnect-spinner"></div>
            <div class="dn-reconnect-text"></div>
        </div>
    </div>
    @* Started by console.js with its own reconnection handler. *@
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_content/DomainNotice.Console/console.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Account pages are static server-rendered forms ([ExcludeFromInteractiveRouting]); everything else is interactive.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
