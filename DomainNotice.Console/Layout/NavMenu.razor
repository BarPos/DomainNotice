<MudNavMenu Class="pt-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">@T["Dashboard"]</MudNavLink>
    <MudNavLink Href="/computers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Computer">@T["Computers"]</MudNavLink>
    <MudNavLink Href="/announcements" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Campaign">@T["Announcements"]</MudNavLink>
    <MudNavLink Href="/confirmations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TaskAlt">@T["Confirmations"]</MudNavLink>
    <MudNavLink Href="/answers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.QuestionAnswer">@T["Answers"]</MudNavLink>
    <MudNavLink Href="/history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">@T["History"]</MudNavLink>
    <MudNavLink Href="/agent-updates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SystemUpdateAlt">@T["Agent updates"]</MudNavLink>
    <MudNavLink Href="/directory" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">@T["Directory"]</MudNavLink>
    <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
        @T["Settings"]
        @if (UpdateAvailable)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="dn-nav-badge" title="@T["A newer release is available"]">@T["Update"]</MudChip>
        }
    </MudNavLink>
    <MudNavLink Href="/audit" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Policy">@T["Audit log"]</MudNavLink>
</MudNavMenu>

@code {
    /// <summary>A newer release is available (IServerUpdateService.GetStatusAsync).</summary>
    [Parameter] public bool UpdateAvailable { get; set; }
}
