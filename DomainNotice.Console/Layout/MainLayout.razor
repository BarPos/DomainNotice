@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject BrowserClock Clock
@inject IServerUpdateService Updates
@inject NavigationManager Nav
@inject ILogger<MainLayout> Logger

<MudThemeProvider Theme="ConsoleTheme.Theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Class="dn-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)"
                       aria-label="Collapse or expand the navigation" />
        <MudIcon Icon="@Icons.Material.Filled.Campaign" Class="ml-2 mr-2" />
        <MudText Typo="Typo.h6" Class="dn-brand">DomainNotice</MudText>
        <MudSpacer />
        <div class="dn-appbar-search">
            <MudTextField T="string" @bind-Value="_search" Placeholder="Search computers, users, announcements" Variant="Variant.Text"
                          Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Inherit"
                          Immediate="true" OnKeyUp="SearchKeyUp" Underline="false" Class="px-2" aria-label="Global search" />
        </div>
        <MudSpacer />
        <MudTooltip Text="@(_dark ? "Light theme" : "Dark theme")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleThemeAsync" />
        </MudTooltip>
        <AuthorizeView>
            <Authorized>
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="ml-2 mr-1" />
                <MudText Typo="Typo.body2" Class="mr-1">@(context.User.FindFirst(ConsoleAuth.DisplayNameClaim)?.Value ?? context.User.Identity?.Name)</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" Class="mr-2">
                    @(context.User.IsAdmin() ? "Admin" : "Read-only")
                </MudChip>
                <form method="post" action="/account/logout" class="d-inline">
                    <AntiforgeryToken />
                    <MudTooltip Text="Sign out">
                        <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Sign out" />
                    </MudTooltip>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always" Elevation="0" Class="dn-drawer">
        <NavMenu UpdateAvailable="_updateAvailable" />
    </MudDrawer>
    <MudMainContent>
        <div class="pa-4">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _dark;
    private bool _updateAvailable;
    private string? _search;

    protected override void OnInitialized() => Clock.Changed += OnClockChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            Clock.SetZone(await JS.InvokeAsync<string?>("domainNotice.timeZone"));
            var theme = await JS.InvokeAsync<string?>("domainNotice.getTheme");
            _dark = theme is null ? await JS.InvokeAsync<bool>("domainNotice.prefersDark") : theme == "dark";
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Browser helpers unavailable");
        }
        try
        {
            _updateAvailable = (await Updates.GetStatusAsync()).UpdateAvailable;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the update status");
        }
        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        try { await JS.InvokeVoidAsync("domainNotice.setTheme", _dark ? "dark" : "light"); }
        catch (JSException) { }
    }

    private void SearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !string.IsNullOrWhiteSpace(_search))
            Nav.NavigateTo("/search?q=" + Uri.EscapeDataString(_search.Trim()));
    }

    private void OnClockChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Clock.Changed -= OnClockChanged;
}
