@page "/announcements"
@inject IAnnouncementService AnnouncementService
@inject ConsoleUser Me
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject TimeProvider Time

<PageTitle>@T["Announcements"] · DomainNotice</PageTitle>

<div class="dn-page-title">
    <MudText Typo="Typo.h5">@T["Announcements"]</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
        <MudButton Href="/announcements/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">@T["New announcement"]</MudButton>
    </AuthorizeView>
</div>

<DataGrid @ref="_grid" TRow="AnnouncementRow" List="ConsoleLists.Announcements" Cells="_cells"
          RowHref="@(r => $"/announcements/{r.Id}")" ActionBar="_actionBar" ContextMenu="_contextMenu" />

@code {
    private DataGrid<AnnouncementRow>? _grid;

    private Dictionary<string, RenderFragment<AnnouncementRow>> _cells => new()
    {
        ["status"] = r => @<AnnouncementStatusChip Status="@r.StatusAt(Time.GetUtcNow().UtcDateTime)" />,
        ["target"] = r => @<span>@(r.Targets.Count == 0 ? T["Everyone"] : r.TargetSummary)</span>,
        ["title"] = r => @<MudLink Href="@($"/announcements/{r.Id}")" @onclick:stopPropagation="true">@r.Title</MudLink>,
    };

    private RenderFragment<IReadOnlyList<AnnouncementRow>> _actionBar => rows => @<AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
        <MudButton StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteAsync(rows))">@T["Delete"]</MudButton>
    </AuthorizeView>;

    private RenderFragment<AnnouncementRow> _contextMenu => row => @<text>
        <MudMenuItem Icon="@Icons.Material.Filled.BarChart" Href="@($"/announcements/{row.Id}")">@T["Results"]</MudMenuItem>
        <AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" Href="@($"/announcements/{row.Id}/edit")">@T["Edit"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteAsync([row]))">@T["Delete"]</MudMenuItem>
        </AuthorizeView>
    </text>;

    private async Task DeleteAsync(IReadOnlyList<AnnouncementRow> rows)
    {
        if (await Me.RequireAdminAsync() is not { } actor) return;
        var names = string.Join(", ", rows.Take(3).Select(r => $"\"{r.Title}\""));
        if (rows.Count > 3) names = T.F("{0} and {1} more", names, rows.Count - 3);
        if (!await PromptDialog.ConfirmAsync(Dialogs, T["Delete announcements"],
                T.F("Delete {0} with all deliveries, confirmations and answers? Open windows on the computers are withdrawn.", names), T["Delete"])) return;
        var ok = 0;
        foreach (var row in rows)
        {
            var result = await AnnouncementService.DeleteAsync(row.Id, actor);
            if (result.Ok) ok++;
            else Snackbar.Add($"{row.Title}: {T.Maybe(result.Error)}", Severity.Error);
        }
        if (ok > 0) Snackbar.Add(T.F("{0} announcement(s) deleted.", ok), Severity.Success);
        _grid?.ClearSelection();
        if (_grid is not null) await _grid.ReloadAsync();
    }
}
