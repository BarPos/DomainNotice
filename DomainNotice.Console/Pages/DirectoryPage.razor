@page "/directory"
@using Microsoft.Extensions.Options
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDirectoryAdmin DirectoryAdmin
@inject IOptions<DomainNotice.Server.Options.DirectoryOptions> DirectoryOptions
@inject NavigationManager Nav
@inject ConsoleUser Me
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject BrowserClock Clock

<PageTitle>@T["Directory"] · DomainNotice</PageTitle>

<div class="dn-page-title">
    <MudText Typo="Typo.h5">@T["Directory"]</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="@(!DirectoryAdmin.IsConfigured || _busy)" OnClick="@(() => SyncAsync(false))">@T["Sync now"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SyncAlt" Disabled="@(!DirectoryAdmin.IsConfigured || _busy)" OnClick="@(() => SyncAsync(true))">@T["Full sync"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NetworkCheck" Disabled="@(!DirectoryAdmin.IsConfigured || _busy)" OnClick="TestAsync">@T["Test connection"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" Disabled="@(!DirectoryAdmin.IsConfigured)" OnClick="SetPasswordAsync">@T["Set bind password"]</MudButton>
    </AuthorizeView>
</div>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    @if (!DirectoryAdmin.IsConfigured)
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            @T["No directory is configured (Directory:Hosts and Directory:BaseDn in the config file). Sign-in uses local accounts, and announcements can target typed user and computer names only."]
        </MudAlert>
    }
    else if (_status is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        var o = DirectoryOptions.Value;
        <div class="d-flex flex-wrap gap-8">
            <div><MudText Typo="Typo.caption">@T["Domain controllers"]</MudText><MudText>@T.F("{0} (port {1}, {2})", string.Join(", ", o.Hosts), o.Port, o.Security)</MudText></div>
            <div><MudText Typo="Typo.caption">@T["Base DN"]</MudText><MudText Class="dn-mono">@o.BaseDn</MudText></div>
            <div><MudText Typo="Typo.caption">@T["Bind password from"]</MudText><MudText>@o.BindPasswordSource</MudText></div>
            <div><MudText Typo="Typo.caption">@T["Last successful sync"]</MudText><MudText>@(_status.LastSuccessUtc is null ? T["Never"] : Clock.Format(_status.LastSuccessUtc))</MudText></div>
            <div><MudText Typo="Typo.caption">@T["Last attempt"]</MudText><MudText>@Clock.Format(_status.LastAttemptUtc)</MudText></div>
            <div><MudText Typo="Typo.caption">@T["Objects"]</MudText><MudText>@_status.ObjectCount</MudText></div>
            <div><MudText Typo="Typo.caption">@T["State"]</MudText><MudText>@(_status.Running ? T["Sync running…"] : T["Idle"])</MudText></div>
        </div>
        @if (_status.LastError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@T.F("Last error: {0}", T.Maybe(_status.LastError))</MudAlert>
        }
    }
</MudPaper>

<div class="dn-split">
    <MudPaper Outlined="true" Class="dn-tree pa-2">
        @if (_ous.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="pa-2">@T["Nothing synced yet."]</MudText>
        }
        <MudTreeView T="string" SelectedValue="@(Parent ?? "")" SelectedValueChanged="ParentChanged" SelectionMode="SelectionMode.SingleSelection" Dense="true" Hover="true">
            @OuNodes(null)
        </MudTreeView>
    </MudPaper>
    <DataGrid TRow="DirectoryObjectRow" List="ConsoleLists.DirectoryObjects" Scope="_scope" Cells="_cells" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "parent")] public string? Parent { get; set; }

    private sealed record OuNode(Guid Id, Guid? ParentGuid, string Name);

    private DirectorySyncStatus? _status;
    private List<OuNode> _ous = [];
    private bool _busy;
    private Dictionary<string, string?> _scope = new();

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;
        await LoadAsync();
    }

    protected override void OnParametersSet() => _scope = new Dictionary<string, string?> { ["parent"] = Parent };

    private async Task LoadAsync()
    {
        if (DirectoryAdmin.IsConfigured) _status = await DirectoryAdmin.GetStatusAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        var containers = await db.DirectoryObjects.AsNoTracking()
            .Where(d => !d.Deleted && (d.Kind == DirectoryObjectKind.Domain || d.Kind == DirectoryObjectKind.OrganizationalUnit || d.Kind == DirectoryObjectKind.Container))
            .OrderBy(d => d.Name).Select(d => new OuNode(d.ObjectGuid, d.ParentGuid, d.Name)).ToListAsync();
        var ids = containers.Select(c => c.Id).ToHashSet();
        _ous = containers.Select(c => c.ParentGuid is { } p && ids.Contains(p) ? c : c with { ParentGuid = null }).ToList();
    }

    private RenderFragment OuNodes(Guid? parent) => @<text>
        @foreach (var ou in _ous.Where(o => o.ParentGuid == parent))
        {
            <MudTreeViewItem T="string" Value="@ou.Id.ToString()" Text="@ou.Name" Icon="@Icons.Material.Filled.Folder" Expanded="@(parent is null)">
                @if (_ous.Any(o => o.ParentGuid == ou.Id))
                {
                    @OuNodes(ou.Id)
                }
            </MudTreeViewItem>
        }
    </text>;

    private void ParentChanged(string? value)
    {
        if (string.IsNullOrEmpty(value) || value == Parent) return;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["parent"] = value, ["page"] = null }));
    }

    private Dictionary<string, RenderFragment<DirectoryObjectRow>> _cells => new()
    {
        ["kind"] = r => @<span>@T[GridField.Humanize(r.Kind.ToString())]</span>,
        ["agent"] = r => @<span>
            @if (r.Kind == DirectoryObjectKind.Computer)
            {
                @if (r.EnrolledComputerId is { } id) { <MudLink Href="@($"/computers/{id}")">@T["Enrolled"]</MudLink> }
                else { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@T["No agent"]</MudChip> }
            }
        </span>,
    };

    private async Task SyncAsync(bool full)
    {
        if (await Me.RequireAdminAsync() is not { } actor) return;
        _busy = true;
        try
        {
            await DirectoryAdmin.RequestSyncAsync(full, actor);
            Snackbar.Add(full ? T["Full sync requested."] : T["Incremental sync requested."], Severity.Info);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync()
    {
        if (await Me.RequireAdminAsync() is null) return;
        _busy = true;
        try
        {
            var result = await DirectoryAdmin.TestConnectionAsync();
            Snackbar.Add(result.Ok ? T["The service account could bind to the directory."] : T.F("Connection failed: {0}", T.Maybe(result.Error)),
                result.Ok ? Severity.Success : Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetPasswordAsync()
    {
        if (await Me.RequireAdminAsync() is not { } actor) return;
        var note = DirectoryOptions.Value.BindPasswordSource == "Database"
            ? T["It is stored encrypted in the database."]
            : T.F("Note: Directory:BindPasswordSource is \"{0}\"; set it to \"Database\" for this password to be used.", DirectoryOptions.Value.BindPasswordSource);
        var password = await PromptDialog.AskAsync(Dialogs, T["Set bind password"], T["Bind password"], T["Save"], secret: true, confirm: true,
            message: T.F("Password of the bind account {0}. {1}", DirectoryOptions.Value.BindUser, note));
        if (password is null) return;
        var result = await DirectoryAdmin.SetBindPasswordAsync(password, actor);
        Snackbar.Add(result.Ok ? T["Bind password saved."] : T.Maybe(result.Error) ?? T["Failed."], result.Ok ? Severity.Success : Severity.Error);
    }
}
