@page "/answers"
@inject NavigationManager Nav

<PageTitle>Answers · DomainNotice</PageTitle>

<div class="dn-page-title">
    <MudText Typo="Typo.h5">Answers</MudText>
</div>

<MudTabs Outlined="true" Rounded="true" ActivePanelIndex="Tab" ActivePanelIndexChanged="TabChanged" KeepPanelsAlive="false" TabPanelsClass="pa-4">
    <MudTabPanel Text="Named answers" Icon="@Icons.Material.Filled.Person">
        <DataGrid TRow="NamedAnswerRow" List="ConsoleLists.NamedAnswers" Prefix="n." Cells="_named" />
    </MudTabPanel>
    <MudTabPanel Text="Anonymous answers" Icon="@Icons.Material.Filled.VisibilityOff">
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Anonymous answers have no user, computer or time. They can only be filtered by announcement, question and option,
            and are listed by content, never in the order they were stored.
        </MudAlert>
        <DataGrid TRow="AnonymousAnswerRow" List="ConsoleLists.AnonymousAnswers" Prefix="a." Cells="_anonymous" />
    </MudTabPanel>
</MudTabs>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public int? TabParam { get; set; }
    private int Tab => Math.Clamp(TabParam ?? 0, 0, 1);

    // MudTabs can raise this while panels register during prerendering; navigating then throws mid-stream.
    private void TabChanged(int index)
    {
        if (!RendererInfo.IsInteractive || index == Tab) return;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", index == 0 ? null : index), replace: true);
    }

    private Dictionary<string, RenderFragment<NamedAnswerRow>> _named => new()
    {
        ["announcement"] = r => @<MudLink Href="@($"/announcements/{r.AnnouncementId}?tab=2")">@r.AnnouncementTitle</MudLink>,
    };

    private Dictionary<string, RenderFragment<AnonymousAnswerRow>> _anonymous => new()
    {
        ["announcement"] = r => @<MudLink Href="@($"/announcements/{r.AnnouncementId}?tab=2")">@r.AnnouncementTitle</MudLink>,
    };
}
