@page "/agent-updates"
@inject IAgentUpdateService AgentUpdateService
@inject ConsoleUser Me
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@T["Agent updates"] · DomainNotice</PageTitle>

<div class="dn-page-title">
    <MudText Typo="Typo.h5">@T["Agent updates"]</MudText>
    <MudText Typo="Typo.body2">@T.F("Agents always update to the server's version ({0}).", AppVersion.Current)</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdateAlt" OnClick="UpdateAllAsync">@T["Update all outdated"]</MudButton>
    </AuthorizeView>
</div>

<DataGrid @ref="_grid" TRow="AgentUpdateRow" List="ConsoleLists.AgentUpdates" Cells="_cells" ActionBar="_actionBar" ContextMenu="_contextMenu" />

@code {
    private DataGrid<AgentUpdateRow>? _grid;

    private Dictionary<string, RenderFragment<AgentUpdateRow>> _cells => new()
    {
        ["computer"] = r => @<MudLink Href="@($"/computers/{r.ComputerId}")">@r.ComputerName</MudLink>,
        ["error"] = r => @<span>@T.Maybe(r.Error)</span>,
        ["state"] = r => @<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StateColor(r.State)">@T[r.State.ToString()]</MudChip>,
    };

    private static Color StateColor(AgentUpdateState s) => s switch
    {
        AgentUpdateState.Done => Color.Success,
        AgentUpdateState.Failed => Color.Error,
        AgentUpdateState.Cancelled => Color.Default,
        _ => Color.Info,
    };

    private RenderFragment<IReadOnlyList<AgentUpdateRow>> _actionBar => rows => @<AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
        <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => CancelAsync(rows))" Disabled="@(!rows.Any(r => r.IsOpen))">@T["Cancel"]</MudButton>
    </AuthorizeView>;

    private RenderFragment<AgentUpdateRow> _contextMenu => row => @<text>
        <MudMenuItem Icon="@Icons.Material.Filled.Computer" Href="@($"/computers/{row.ComputerId}")">@T["Computer"]</MudMenuItem>
        <AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
            <MudMenuItem Icon="@Icons.Material.Filled.Cancel" Disabled="@(!row.IsOpen)" OnClick="@(() => CancelAsync([row]))">@T["Cancel task"]</MudMenuItem>
        </AuthorizeView>
    </text>;

    private async Task CancelAsync(IReadOnlyList<AgentUpdateRow> rows)
    {
        if (await Me.RequireAdminAsync() is not { } actor) return;
        var open = rows.Where(r => r.IsOpen).ToList();
        if (open.Count == 0) return;
        if (!await PromptDialog.ConfirmAsync(Dialogs, T["Cancel update tasks"], T.F("Cancel {0} open update task(s)?", open.Count), T["Cancel tasks"])) return;
        var ok = 0;
        foreach (var row in open)
        {
            var result = await AgentUpdateService.CancelAsync(row.Id, actor);
            if (result.Ok) ok++;
            else Snackbar.Add($"{row.ComputerName}: {T.Maybe(result.Error)}", Severity.Error);
        }
        if (ok > 0) Snackbar.Add(T.F("{0} task(s) cancelled.", ok), Severity.Success);
        _grid?.ClearSelection();
        if (_grid is not null) await _grid.ReloadAsync();
    }

    private async Task UpdateAllAsync()
    {
        if (await Me.RequireAdminAsync() is not { } actor) return;
        if (!await PromptDialog.ConfirmAsync(Dialogs, T["Update all outdated agents"], T.F("Send the update command to every outdated agent (to {0})?", AppVersion.Current), T["Update all"])) return;
        var (result, created) = await AgentUpdateService.RequestUpdateAllOutdatedAsync(actor);
        Snackbar.Add(result.Ok ? T.F("{0} update task(s) created.", created) : T.Maybe(result.Error) ?? T["Failed."], result.Ok ? Severity.Success : Severity.Error);
        if (_grid is not null) await _grid.ReloadAsync();
    }
}
