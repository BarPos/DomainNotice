@page "/agent-updates"
@inject IAgentUpdateService AgentUpdateService
@inject ConsoleUser Me
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Agent updates · DomainNotice</PageTitle>

<div class="dn-page-title">
    <MudText Typo="Typo.h5">Agent updates</MudText>
    <MudText Typo="Typo.body2">Agents always update to the server's version (@AppVersion.Current).</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdateAlt" OnClick="UpdateAllAsync">Update all outdated</MudButton>
    </AuthorizeView>
</div>

<DataGrid @ref="_grid" TRow="AgentUpdateRow" List="ConsoleLists.AgentUpdates" Cells="_cells" ActionBar="_actionBar" ContextMenu="_contextMenu" />

@code {
    private DataGrid<AgentUpdateRow>? _grid;

    private Dictionary<string, RenderFragment<AgentUpdateRow>> _cells => new()
    {
        ["computer"] = r => @<MudLink Href="@($"/computers/{r.ComputerId}")">@r.ComputerName</MudLink>,
        ["state"] = r => @<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StateColor(r.State)">@r.State</MudChip>,
    };

    private static Color StateColor(AgentUpdateState s) => s switch
    {
        AgentUpdateState.Done => Color.Success,
        AgentUpdateState.Failed => Color.Error,
        AgentUpdateState.Cancelled => Color.Default,
        _ => Color.Info,
    };

    private RenderFragment<IReadOnlyList<AgentUpdateRow>> _actionBar => rows => @<AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
        <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => CancelAsync(rows))" Disabled="@(!rows.Any(r => r.IsOpen))">Cancel</MudButton>
    </AuthorizeView>;

    private RenderFragment<AgentUpdateRow> _contextMenu => row => @<text>
        <MudMenuItem Icon="@Icons.Material.Filled.Computer" Href="@($"/computers/{row.ComputerId}")">Computer</MudMenuItem>
        <AuthorizeView Policy="@ConsoleAuth.AdminPolicy">
            <MudMenuItem Icon="@Icons.Material.Filled.Cancel" Disabled="@(!row.IsOpen)" OnClick="@(() => CancelAsync([row]))">Cancel task</MudMenuItem>
        </AuthorizeView>
    </text>;

    private async Task CancelAsync(IReadOnlyList<AgentUpdateRow> rows)
    {
        if (await Me.RequireAdminAsync() is not { } actor) return;
        var open = rows.Where(r => r.IsOpen).ToList();
        if (open.Count == 0) return;
        if (!await PromptDialog.ConfirmAsync(Dialogs, "Cancel update tasks", $"Cancel {open.Count} open update task(s)?", "Cancel tasks")) return;
        var ok = 0;
        foreach (var row in open)
        {
            var result = await AgentUpdateService.CancelAsync(row.Id, actor);
            if (result.Ok) ok++;
            else Snackbar.Add($"{row.ComputerName}: {result.Error}", Severity.Error);
        }
        if (ok > 0) Snackbar.Add($"{ok} task(s) cancelled.", Severity.Success);
        _grid?.ClearSelection();
        if (_grid is not null) await _grid.ReloadAsync();
    }

    private async Task UpdateAllAsync()
    {
        if (await Me.RequireAdminAsync() is not { } actor) return;
        if (!await PromptDialog.ConfirmAsync(Dialogs, "Update all outdated agents", $"Send the update command to every outdated agent (to {AppVersion.Current})?", "Update all")) return;
        var (result, created) = await AgentUpdateService.RequestUpdateAllOutdatedAsync(actor);
        Snackbar.Add(result.Ok ? $"{created} update task(s) created." : result.Error ?? "Failed.", result.Ok ? Severity.Success : Severity.Error);
        if (_grid is not null) await _grid.ReloadAsync();
    }
}
