@page "/error"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>@T["Error"] · DomainNotice</PageTitle>

<h1>@T["Something went wrong"]</h1>
<p class="dn-sub">@(RequestId is null ? T["The request could not be completed. The details are in the server log."] : T.F("The request could not be completed. The details are in the server log (request {0}).", RequestId))</p>
<div class="dn-account-foot"><a href="/">@T["Back to the console"]</a></div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? RequestId => System.Diagnostics.Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
