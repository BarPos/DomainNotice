<Project Sdk="Microsoft.NET.Sdk.Web">
    <!-- The host: Kestrel for the Console, agent listener, background jobs, CLI: migrate-only, create-local-account. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>DomainNotice.Server</RootNamespace>
        <AssemblyName>DomainNotice.Server</AssemblyName>
        <InvariantGlobalization>false</InvariantGlobalization>
        <UserSecretsId>domainnotice-server-dev</UserSecretsId>
        <!-- The host has no .razor files, so ask the SDK for the Blazor framework script (_framework/blazor.web.js). -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DomainNotice.Server.Core\DomainNotice.Server.Core.csproj" />
        <ProjectReference Include="..\DomainNotice.Console\DomainNotice.Console.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="DomainNotice.Server.Tests" />
    </ItemGroup>
</Project>
