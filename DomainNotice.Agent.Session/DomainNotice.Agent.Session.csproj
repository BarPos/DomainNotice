<Project Sdk="Microsoft.NET.Sdk">
    <!-- Per-session UI: tray icon (no Exit) and announcement window. Talks only to the local Agent service over a named pipe. -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>DomainNotice.Agent.Session</RootNamespace>
        <AssemblyName>DomainNotice.Agent.Session</AssemblyName>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Markdig" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DomainNotice.Shared\DomainNotice.Shared.csproj" />
    </ItemGroup>
</Project>
