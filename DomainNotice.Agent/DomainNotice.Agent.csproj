<Project Sdk="Microsoft.NET.Sdk.Worker">
    <!-- Windows service (LocalSystem): server connection, keys, session tracking, starts Agent.Session. -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>DomainNotice.Agent</RootNamespace>
        <AssemblyName>DomainNotice.Agent</AssemblyName>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
        <UserSecretsId>domainnotice-agent-dev</UserSecretsId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DomainNotice.Shared\DomainNotice.Shared.csproj" />
    </ItemGroup>
</Project>
